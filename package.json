{
  "name": "evosubagent",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Pi-first customizable subagents with a minimal self-improve loop",
  "bin": {
    "evosubagent": "./src/cli/main.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo:correct-once": "node ./src/cli/main.mjs demo correct-once --project ./fixtures/demo-correct-once/project",
    "evosubagent": "node ./src/cli/main.mjs",
    "eval:mini": "node eval/runners/mini-bench.mjs",
    "eval:summarize": "node eval/runners/summarize.mjs",
    "live:smoke": "node ./scripts/live-smoke.mjs",
    "eval:tb-dry": "node eval/runners/tb-subset.mjs --dry-run",
    "eval:tb": "node eval/runners/tb-subset.mjs --arm both",
    "eval:tb-summarize": "node eval/runners/summarize-tb.mjs",
    "eval:fix-git-dual": "node eval/runners/fix-git-dual-arm.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi",
    "subagent",
    "evosubagent",
    "self-improve"
  ],
  "license": "MIT",
  "evosubagent": {
    "piPackage": "@earendil-works/pi-coding-agent",
    "piVersionPin": "0.80.10",
    "defaultLiveModel": "cpa-oai/grok-4.5",
    "tbSubset": {
      "config": "eval/configs/tb-subset-v0.json",
      "dataset": "terminal-bench@2.0",
      "taskListHash": "87030810172cd45c"
    }
  }
}
